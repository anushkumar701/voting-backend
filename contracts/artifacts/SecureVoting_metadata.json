		"devdoc": {
			"details": "Blockchain-based voting system for academic project Features: - Multiple elections support - One vote per voter per election - Immutable vote records - Admin-only election creation - Transparent vote counting",
			"kind": "dev",
			"methods": {
				"castVote(uint256,uint256)": {
					"details": "Cast a vote in an election",
					"params": {
						"_candidateId": "Candidate ID",
						"_electionId": "Election ID"
					}
				},
				"constructor": {
					"details": "Sets the contract deployer as admin"
				},
				"createElection(string,string,string[])": {
					"details": "Creates a new election (admin only)",
					"params": {
						"_candidateNames": "Array of candidate names",
						"_description": "Election description",
						"_name": "Election name"
					}
				},
				"getAllCandidates(uint256)": {
					"details": "Get all candidates for an election",
					"params": {
						"_electionId": "Election ID"
					}
				},
				"getCandidate(uint256,uint256)": {
					"details": "Get candidate details",
					"params": {
						"_candidateId": "Candidate ID",
						"_electionId": "Election ID"
					}
				},
				"getElection(uint256)": {
					"details": "Get election details",
					"params": {
						"_electionId": "Election ID"
					}
				},
				"hasVoterVoted(uint256,address)": {
					"details": "Check if voter has voted in an election",
					"params": {
						"_electionId": "Election ID",
						"_voter": "Voter address"
					}
				},
				"setElectionStatus(uint256,bool)": {
					"details": "Toggle election status (admin only)",
					"params": {
						"_electionId": "Election ID",
						"_status": "New status (true = active, false = inactive)"
					}
				}
			},
